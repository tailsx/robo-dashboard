{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ES2022",
    "baseUrl": "./",
    "paths": {
      "#*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist"]
}
